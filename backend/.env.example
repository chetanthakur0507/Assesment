# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional overrides — sensible defaults are baked in if you leave these unset.
# Check https://console.groq.com/docs/models for current model IDs, since
# Groq periodically deprecates/renames models.
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=openai/gpt-oss-120b
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=autumn

PORT=8787
